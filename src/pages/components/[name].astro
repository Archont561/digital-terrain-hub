---
import _ from "lodash";
import { WorkspaceTableRow } from "@/components/ninjaodm/workspaces";
import { renderComponent } from "@/lib";
import BaseLayout from "@/layouts/BaseLayout.astro";

if (import.meta.env.MODE != "test") {
  return Astro.rewrite("/404");
}

const COMPONENTS = [
  WorkspaceTableRow,
];

const paramName = _.toLower(Astro.params.name || "");
const Component = _.find(COMPONENTS, (c) => _.toLower(c.name) === paramName);

if (!Component) {
  return Astro.rewrite("/404");
}

const url = new URL(Astro.request.url);
const rawProps = url.searchParams.get("props");
const props = rawProps
  ? JSON.parse(decodeURIComponent(rawProps))
  : {};

const componentString = await renderComponent.asString(Component, {
  props: props as any,
});

// Astro render api does not resolve scripts correctly !!!
const componentStringScriptSanitized = componentString.replace(
  /src\s*=\s*["'][^"']*\/src\//g,
  'src="/src/'
);
const isTablePartial = [
  WorkspaceTableRow.name,
].includes(Component.name);
---

<BaseLayout title={`Testing ${Component.name}`}>
  {isTablePartial 
  ? <table>
    <Fragment set:html={componentStringScriptSanitized} />
  </table> 
  : <Fragment set:html={componentStringScriptSanitized} />
}
</BaseLayout>
