---
import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import PlusIcon from "@tabler/icons/outline/plus.svg";
import {
  Table,
  TableHeader,
  TableHead,
  TableBody,
  TableRow,
  TableCell,
} from "@/components/starwind/table";
import {
  Dialog,
  DialogTrigger,
  DialogContent,
  DialogHeader,
  DialogFooter,
  DialogTitle,
  DialogDescription,
  DialogClose,
} from "@/components/starwind/dialog";
import {
  Select,
  SelectContent,
  SelectGroup,
  SelectItem,
  SelectLabel,
  SelectSeparator,
  SelectTrigger,
  SelectValue,
} from "@/components/starwind/select";

import WorkspaceTableRowTemplate from "./WorkspaceTableRowTemplate.astro";
import { TusImageUploader } from "../image";

import type { WorkspaceManagerProps } from "./controllers";
type Props = WorkspaceManagerProps;

const headers = ["Name", "Created", "Actions"];
const {
  workspaces = [],
  baseEditUrl,
  workspaceImageUploadUrlTemplate,
} = Astro.props;

const ninjaId = "dummy-ninja-id";
---

<style is:global>
  [x-cloak] {
    display: none;
  }
</style>

<div
  x-ignore
  data-ninjaodm-component="WorkspaceManager"
  data-ninjaodm-id={ninjaId}
  x-data="WorkspaceManager(window.ninjaodmData[$el.dataset.ninjaodmId])"
  class="max-w-lg mx-auto"
>
  <!-- Toolbar -->
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold">Workspaces</h2>

    <Button
      size="sm"
      variant="outline"
      x-on:click="createWorkspace()"
      x-show="!isEmpty"
      class="rounded-full"
    >
      <PlusIcon class="size-4" /> Create New
    </Button>
  </div>

  <Table>
    <TableHeader>
      <TableRow>
        {
          headers.map((header) => (
            <TableHead class:list={{ "text-right": header === "Actions" }}>
              {header}
            </TableHead>
          ))
        }
      </TableRow>
    </TableHeader>

    <TableBody>
      <WorkspaceTableRowTemplate />

      <!-- Empty State -->
      <TableRow x-show="isEmpty" x-cloak>
        <TableCell
          colspan={headers.length}
          class="text-center p-8 text-muted-foreground"
        >
          <div class="flex flex-col items-center gap-3">
            <span>No workspaces found.</span>
            <Button variant="outline" x-on:click="createWorkspace()">
              Create New Workspace
            </Button>
          </div>
        </TableCell>
      </TableRow>
    </TableBody>
  </Table>

  <Dialog>
    <DialogTrigger x-ref="workspaceImageUploadDialogTrigger" class="hidden" />
    <DialogContent>
      <DialogHeader class="text-left">
        <DialogTitle>Upload Images</DialogTitle>
      </DialogHeader>
      <TusImageUploader
        x-ref="TusImageUploader"
        uploadUrl={workspaceImageUploadUrlTemplate}
      />
    </DialogContent>
  </Dialog>

  <Dialog>
    <DialogTrigger x-ref="workspaceTaskCreationDialogTrigger" class="hidden" />
    <DialogContent class="sm:max-w-[450px]" animationDuration={200}>
      <form
        x-ref="taskCreationForm"
        class="flex flex-col gap-4"
      >
        <DialogHeader class="text-left">
          <DialogTitle>Create new Task</DialogTitle>
          <DialogDescription>
            Define processing task options. Click save when you're done.
          </DialogDescription>
        </DialogHeader>
        <div class="grid gap-4 py-4">
          <div class="grid grid-cols-4 items-center gap-4">
            <Label class="text-right"> Name </Label>
            <Input name="name" class="col-span-3" required/>
          </div>
          <div class="grid grid-cols-4 items-center gap-4">
            <Label class="text-right"> Result quality </Label>
            <Select name="quality" class="w-full" required>
              <SelectTrigger class="w-[150px]">
                <SelectValue placeholder="Select" />
              </SelectTrigger>
              <SelectContent side="top">
                <SelectItem value="ultra_low">Ultra Low</SelectItem>
                <SelectItem value="low">Low</SelectItem>
                <SelectItem value="medium">Medium</SelectItem>
                <SelectItem value="high">High</SelectItem>
                <SelectItem value="ultra_high">Ultra high</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>
        <DialogFooter>
          <DialogClose asChild>
            <Button x-ref="workspaceTaskCreationDialogCloseBtn" type="button" variant="outline">Cancel</Button>
          </DialogClose>
          <Button type="button" x-on:click="handleTaskCreationSubmit">Create</Button>
        </DialogFooter>
      </form>
    </DialogContent>
  </Dialog>
</div>

<script
  define:vars={{
    workspaces,
    baseEditUrl,
    workspaceImageUploadUrlTemplate,
    ninjaId,
  }}
  is:inline
>
  window.ninjaodmData = window.ninjaodmData || {};
  window.ninjaodmData[ninjaId] = {
    workspaces,
    baseEditUrl,
    workspaceImageUploadUrlTemplate,
  };
</script>

<script>
  import { WorkspaceManager } from "./controllers";
  WorkspaceManager.register(window.Alpine, "WorkspaceManager", () => {
    document
      .querySelectorAll('[data-ninjaodm-component="WorkspaceManager"]')
      .forEach((el) => {
        el.removeAttribute("x-ignore");
        delete (el as any)._x_ignore;
        window.Alpine.initTree(el as any);
      });
  });
</script>
