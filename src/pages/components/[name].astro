---
import _ from "lodash";
import { WorkspaceManager } from "@/components/ninjaodm/workspaces";
import { ResultManager } from "@/components/ninjaodm/results";
import { TaskManager } from "@/components/ninjaodm/tasks";
import { GCPEdtor } from "@/components/ninjaodm/gcps";
import { TusImageUploader } from "@/components/ninjaodm/image";
import { renderComponent } from "@/lib/server";
import BaseLayout from "@/layouts/BaseLayout.astro";

if (import.meta.env.MODE != "test") {
  return Astro.rewrite("/404");
}

const COMPONENTS = [
  WorkspaceManager,
  ResultManager,
  TaskManager,
  GCPEdtor,
  TusImageUploader,
];

const paramName = _.toLower(Astro.params.name || "");
const Component = _.find(COMPONENTS, (c) => _.toLower(c.name) === paramName);

if (!Component) {
  return Astro.rewrite("/404");
}

const url = new URL(Astro.request.url);
const rawProps = url.searchParams.get("props");
const props = rawProps
  ? JSON.parse(decodeURIComponent(rawProps))
  : {};

const componentString = await renderComponent.asString(Component, {
  props: props as any,
});

// Astro render api does not resolve scripts correctly !!!
const componentStringScriptSanitized = componentString.replace(
  /src\s*=\s*["'][^"']*\/src\//g,
  'src="/src/'
);
---

<BaseLayout title={`Testing ${Component.name}`}>
  <Fragment set:html={componentStringScriptSanitized} />
</BaseLayout>
