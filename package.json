{
  "name": "digital-terrain-hub",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun astro dev --mode dev",
    "build": "bun run generate-ninjaodm-client && bunx --bun astro build",
    "preview": "astro preview",
    "start": "bunx --bun ./dist/server/entry.mjs",
    "astro": "astro",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check --write",
    "test:unit": "bun test ./tests/unit",
    "test:integration": "bun test ./tests/integration --preload ./tests/integration/bun.setup.ts",
    "test:e2e": "playwright test --pass-with-no-tests",
    "generate-ninjaodm-client": "openapi-zod-client ./src/assets/ninjaodm.openapi.json -o ./src/lib/ninjaodm/generated-api.ts",
    "start:backend-mock-server": "bunx prism mock ./src/assets/ninjaodm.openapi.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.1",
    "@clerk/astro": "^2.16.10",
    "@inox-tools/runtime-logger": "^0.7.0",
    "@tabler/icons": "^3",
    "@types/alpinejs": "^3.13.11",
    "alpinejs": "^3.15.5",
    "astro": "^5.16.6",
    "embla-carousel": "^8.6.0",
    "fetch-event-stream": "^0.1.6",
    "lodash": "^4.17.23",
    "tailwind-merge": "^3",
    "tailwind-variants": "^3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@clerk/testing": "^1.13.31",
    "@msw/playwright": "^0.4.5",
    "@playwright/test": "^1.57.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@tailwindcss/forms": "^0.5",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.3.8",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.0.6",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "mitt": "^3.0.1",
    "msw": "^2.12.7",
    "openapi-zod-client": "^1.18.3",
    "starwind": "^1.15.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1",
    "typescript": "^5"
  },
  "overrides": {
    "chalk": "4.1.2"
  },
  "trustedDependencies": [
    "@clerk/shared"
  ]
}
