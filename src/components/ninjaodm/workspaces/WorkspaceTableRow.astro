---
import TableCell from "@/components/starwind/table/TableCell.astro";
import TableRow from "@/components/starwind/table/TableRow.astro";
import Button from "@/components/starwind/button";
import Input from "@/components/starwind/input";
import Label from "@/components/starwind/label";

export type WorkspaceProps = {
  uuid: string;
  name: string;
};

type Props = {
  workspaceEditUrl: string;
  workspace: WorkspaceProps;
};

const { workspace, workspaceEditUrl } = Astro.props;
---

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>

<TableRow
  x-data={`WorkspaceTableRow(${JSON.stringify(workspace)})`}
  class="ninjaodm-workspace-table-row"
  x-cloak
>
  <TableCell class="font-medium">
    <Label size="md" x-bind="workspaceNameLabel">{workspace.name}</Label>
    <Input size="md" x-bind="workspaceNameInput" />
  </TableCell>
  <TableCell class="text-right">
    <div class="inline-flex gap-2">
      <Button
        variant="secondary"
        href={`${workspaceEditUrl}/${workspace.uuid}`}
      >
        Edit
      </Button>

      <Button variant="warning" x-bind="deleteWorkspaceBtn">
        Delete
      </Button>
    </div>
  </TableCell>
</TableRow>

<script>
  import { toast } from "@/components/starwind/toast";
  import { actions } from "astro:actions";

  type WorkspaceProps = {
    uuid: string;
    name: string;
  };

  const convertAstroActionCode = (s: string) =>
    s.toLowerCase()
      .replace(/_/g, " ")
      .replace(/\b\w/g, (c) => c.toUpperCase());

  window.Alpine.data("WorkspaceTableRow", (workspace: WorkspaceProps) => ({
    _workspace: workspace,
    _mode: "normal",
    newWorkspaceName: "",

    setMode(mode: string) {
      this._mode = mode;
    },

    isMode(mode: string) {
      return this._mode === mode;
    },

    deleteWorkspaceBtn: {
      async "@click"() {
        const { error } = await actions.deleteWorkspace({
          uuid: this._workspace.uuid,
        });

        if (error) {
          toast.error(convertAstroActionCode(error.code), {
            duration: 2000,
          });
        } else {
          this.$root.remove();
        }
      },
    },

    workspaceNameLabel: {
      "@click"() {
        this.setMode("update");
        this.newWorkspaceName = this._workspace.name;
      },
      "x-show"() {
        return this.isMode("normal");
      },
      "x-text"() {
        return this._workspace.name;
      },
    },

    workspaceNameInput: {
      "x-ref": "workspaceNameInput",
      "x-model": "newWorkspaceName",
      "x-show"() {
        const shouldShow = this.isMode("update");
        shouldShow &&
          this.$nextTick(() => {
            this.$el.focus();
          });
        return shouldShow;
      },
      "@click.away"() {
        this.setMode("normal");
      },
      async "@keyup.enter"() {
        const newName = this.newWorkspaceName.trim();
        if (!newName) {
          toast.error("Validation Error", {
            description: "Workspace name cannot be empty",
            duration: 2000,
          });
          this.setMode("normal");
          return;
        }

        const { error } = await actions.updateWorkspace({
          uuid: this._workspace.uuid,
          payload: { name: newName },
        });

        if (error) {
          toast.error(convertAstroActionCode(error.code), {
            duration: 2000,
          });
        } else {
          this._workspace.name = newName;
        }
        this.setMode("normal");
      },
    },
  }));
</script>
